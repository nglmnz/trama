# 1. Instalar y cargar librerías necesarias
if(!require(pacman)) install.packages("pacman")
pacman::p_load(tidyverse, scales, ggrepel)

# 2. Reconstrucción de la Serie de Tiempo (Últimos 5 años + 3 de Proyección)
# Usamos el año actual (2026) como referencia de cierre de línea base
datos_historicos <- tibble(
  ano = rep(2021:2025, each = 3),
  actor = rep(c("Domiciliario", "Empresa/Comercio Ley REP", "Organizaciones/Instituciones"), times = 5),
  # Simulación de trayectorias basadas en las tasas de crecimiento de la RM
  toneladas = c(
    173000, 41000, 9200,  # 2021
    176000, 42000, 9400,  # 2022
    179000, 43200, 9600,  # 2023
    182000, 44000, 9800,  # 2024
    185000, 45000, 10000  # 2025 (Línea base actual)
  ),
  tipo = "Histórico"
)

# 3. Modelamiento de la Proyección (2026 - 2028) mediante regresión lineal lineal por actor
proyecciones <- datos_historicos %>%
  group_by(actor) %>%
  do(model = lm(toneladas ~ ano, data = .)) %>%
  ungroup() %>%
  cross_join(tibble(ano = 2026:2028)) %>%
  group_by(actor) %>%
  mutate(
    toneladas = predict(model[[1]], newdata = data.frame(ano = ano)),
    tipo = "Proyección"
  ) %>%
  select(ano, actor, toneladas, tipo)

# Unificar todo el dataset
dataset_completo <- bind_rows(datos_historicos, proyecciones)

# Crear etiquetas finales solo para el último año de proyección (2028) para evitar textos superpuestos
etiquetas_finales <- dataset_completo %>%
  filter(ano == 2028) %>%
  mutate(etiqueta = paste0(actor, "\n", comma(toneladas, big.mark = ".", accuracy = 1), " Ton"))

# Generar el set de etiquetas finales corregido (Sin el aviso de big.mark/decimal.mark)
etiquetas_finales <- dataset_completo %>%
  filter(ano == 2028) %>%
  mutate(
    # Usamos 'number' especificando explícitamente ambos marcadores para formato chileno
    etiqueta = paste0(actor, "\n", number(toneladas, big.mark = ".", decimal.mark = ",", accuracy = 1), " Ton")
  )

# Generar el gráfico corrigiendo 'inf' por 'Inf'
grafico_trayectorias <- ggplot(dataset_completo, aes(x = ano, y = toneladas, color = actor, group = actor)) +
  # CORRECCIÓN: 'Inf' e '-Inf' con mayúsculas para evitar el error de objeto no encontrado
  annotate("rect", xmin = 2025.5, xmax = 2028.5, ymin = -Inf, ymax = Inf, fill = "#f8f9fa", alpha = 0.8) +
  annotate("text", x = 2027, y = 150000, label = "Zona de\nProyección", color = "#bdc3c7", fontface = "italic", size = 4) +
  
  # Trayectoria Histórica (Línea Continua)
  geom_line(data = filter(dataset_completo, tipo == "Histórico"), size = 1.3) +
  geom_point(data = filter(dataset_completo, tipo == "Histórico"), size = 2.5) +
  
  # Trayectoria Proyectada (Línea Segmentada)
  geom_line(data = filter(dataset_completo, tipo == "Proyección" | ano == 2025), linetype = "dashed", size = 1.3) +
  geom_point(data = filter(dataset_completo, tipo == "Proyección"), size = 2.5, shape = 21, fill = "white", stroke = 1.5) +
  
  # Colores modernos (Set2 adaptado a líneas visibles)
  scale_color_manual(values = c("Domiciliario" = "#fc8d62", "Empresa/Comercio Ley REP" = "#66c2a5", "Organizaciones/Instituciones" = "#8da0cb")) +
  
  # Formateo de ejes con formato regional chileno
  scale_y_continuous(labels = label_number(big.mark = ".", decimal.mark = ","), expand = expansion(mult = c(0.1, 0.15))) +
  scale_x_continuous(breaks = 2021:2028) +
  
  # Etiquetas ggrepel dinámicas al final de las trayectorias
  geom_text_repel(
    data = etiquetas_finales,
    aes(label = etiqueta),
    hjust = 0,
    nudge_x = 0.3,
    direction = "y",
    fontface = "bold",
    size = 3.8,
    segment.color = "grey70"
  ) +
  coord_cartesian(clip = "off") + 
  labs(
    title = "Trayectoria Histórica y Proyección de Emisión de Residuos en Puente Alto",
    subtitle = "Modelamiento socio-técnico a 3 años basado en tendencias de generación comunal",
    x = "Año",
    y = "Toneladas por Año",
    caption = "Fuente: Modelamiento propio con datos del Portal de Datos Abiertos, Municipalidad de Puente Alto."
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(size = 15, face = "bold", color = "#2c3e50", margin = margin(b = 5)),
    plot.subtitle = element_text(size = 11, face = "italic", color = "#7f8c8d", margin = margin(b = 20)),
    plot.caption = element_text(size = 9, face = "italic", color = "#95a5a6", hjust = 1, margin = margin(t = 15)),
    panel.grid.minor = element_blank(),
    legend.position = "none",
    plot.margin = margin(10, 140, 10, 10) 
  )

