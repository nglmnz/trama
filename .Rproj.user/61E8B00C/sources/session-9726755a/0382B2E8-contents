# 1. Instalar y cargar librerías necesarias
if(!require(pacman)) install.packages("pacman")
# Añadimos 'ggrepel' para evitar la superposición de textos
pacman::p_load(tidyverse, scales, ggrepel)

# 2. Crear el set de datos para Puente Alto
datos_residuos <- tibble(
  actor = c("Domiciliario", "Empresa/Comercio Ley REP", "Organizaciones/Instituciones"),
  toneladas = c(185000, 45000, 10000)
) %>%
  mutate(
    porcentaje = toneladas / sum(toneladas),
    # Modificamos la etiqueta para que sea más compacta en el gráfico
    etiqueta = paste0(actor, "\n", comma(toneladas, big.mark = "."), " Ton/Año (", percent(porcentaje, accuracy = 0.1), ")")
  )

# 3. Generar el gráfico con estética moderna y textos ordenados
grafico_torta <- ggplot(datos_residuos, aes(x = "", y = toneladas, fill = actor)) +
  geom_bar(stat = "identity", width = 1, color = "white", size = 1.2) +
  # Usamos coord_polar para transformarlo en torta
  coord_polar("y", start = 0) +
  # REEMPLAZO: geom_text_repel evita que los textos se junten o superpongan
  geom_text_repel(
    aes(label = etiqueta), 
    position = position_stack(vjust = 0.5), 
    size = 4, 
    fontface = "bold", 
    color = "#2c3e50",
    box.padding = 0.5,
    segment.color = "grey50", # Línea conectora si el texto se aleja mucho
    force = 2
  ) +
  scale_fill_brewer(palette = "Set2") +
  labs(
    title = "Generación de Residuos por Tipo de Actor en Puente Alto",
    subtitle = "Línea base comunal para el modelamiento del sistema socio-técnico",
    caption = "Fuente: Diagnóstico Municipal / Línea Base de Residuos de Puente Alto", # <-- Aquí agregas tu fuente
    fill = "Tipo de Actor"
  ) +
  theme_void() +
  theme(
    plot.title = element_text(size = 15, face = "bold", hjust = 0.5, color = "#2c3e50"),
    plot.subtitle = element_text(size = 11, face = "italic", hjust = 0.5, color = "#7f8c8d", margin = margin(b = 15)),
    plot.caption = element_text(size = 9, face = "italic", color = "#7f8c8d", hjust = 1, margin = margin(t = 15)), # Estilo de la fuente
    legend.position = "none" 
  )

# Mostrar el gráfico en RStudio
print(grafico_torta)

# Guardar la visualización en alta calidad
ggsave("generacion_residuos_puente_alto.png", plot = grafico_torta, width = 10, height = 8, dpi = 300)




